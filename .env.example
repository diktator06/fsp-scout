# Скаут — переменные окружения.
# Для локального запуска файл .env не обязателен: docker-compose.yml содержит рабочие значения
# по умолчанию. Скопируйте этот файл в .env, только если нужно что-то переопределить.

# --- Общие -----------------------------------------------------------------
# local | test | production. В production приложение не стартует с dev-секретом JWT.
APP_ENV=local

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_DB=fsp_scout
# Порт PostgreSQL на хосте (нужен для запуска тестов и миграций вне Docker).
POSTGRES_HOST_PORT=5432

# --- Авторизация -------------------------------------------------------------
# Обязательно замените в production: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# true, если сервис отдаётся по HTTPS.
REFRESH_COOKIE_SECURE=false
EMAIL_VERIFICATION_TTL_HOURS=24
RATE_LIMIT_ENABLED=true
# Секрет HMAC для seed экземпляров заданий: без него нельзя заранее вычислить задания
# сессии. Обязательно замените в production: openssl rand -hex 32
ASSESSMENT_SECRET=dev-only-assessment-secret-change-me

# Число процессов API. Подбор и тест упираются в CPU: на сервере ставьте по числу ядер,
# каждый процесс занимает около 200 МБ памяти.
WEB_CONCURRENCY=2

# --- Почта ------------------------------------------------------------------
# smtp — отправка через SMTP (в демо это Mailpit), console — письма пишутся в лог.
MAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
MAIL_FROM=Скаут <no-reply@fsp-scout.local>

# --- Адреса -----------------------------------------------------------------
# Адрес фронтенда: из него строятся ссылки в письмах.
FRONTEND_URL=http://localhost:8080
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=8000
MAILPIT_UI_HOST_PORT=8025
# Ссылка на веб-интерфейс Mailpit, которую фронтенд показывает на экране «Проверьте почту».
# Оставьте пустой, чтобы скрыть подсказку.
VITE_MAILPIT_URL=http://localhost:8025

# --- Демо-данные --------------------------------------------------------------
# Создавать демо-аккаунты кандидата, работодателя и методиста при старте.
SEED_DEMO_USERS=true
# Тестовый пароль демо-аккаунтов (только для локального стенда).
DEMO_PASSWORD=ScoutDemo2026

# --- ФСП ID и реестр достижений ------------------------------------------------
# В демо это эмулятор fsp-registry-mock. Для настоящего ФСП ID (Keycloak) достаточно
# поменять адрес провайдера, идентификатор и секрет клиента.
FSP_ENABLED=true
# Публичный адрес провайдера: на него уходит браузер, он же claim iss в токенах.
FSP_PUBLIC_URL=http://localhost:8090
# Адрес провайдера изнутри Docker-сети (обмен кода, JWKS, API реестра).
# Для внешнего провайдера оставьте пустым: тогда используется публичный адрес.
FSP_INTERNAL_URL=http://fsp-registry-mock:8090
# Адрес API реестра достижений, если он отделён от ФСП ID (пусто — тот же сервер).
FSP_REGISTRY_URL=
FSP_CLIENT_ID=fsp-scout
# Обязательно замените в production.
FSP_CLIENT_SECRET=dev-only-fsp-client-secret
FSP_HOST_PORT=8090
# Пароль вымышленных участников на странице входа эмулятора.
FSP_DEMO_PASSWORD=FspDemo2026
# Доля синтетических кандидатов, привязанных к участникам эмулятора (0 — без ФСП).
DEMO_FSP_LINK_SHARE=0.4
# Claim с номером участника реестра. У эмулятора это sub; в Keycloak sub — UUID
# пользователя, а номер приходит из атрибута (docker-compose.keycloak.yml ставит
# fsp_participant_id сам).
FSP_PARTICIPANT_CLAIM=sub

# --- ФСП ID на Keycloak (make up-keycloak) --------------------------------------
KEYCLOAK_HOST_PORT=8081
# Админка Keycloak — только для локального стенда.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Интеграция с ATS работодателя ----------------------------------------------
# Разрешить вебхуки на адреса внутренней сети (localhost, 10.x, 192.168.x).
# По умолчанию запрещено — защита от SSRF. Включайте только для локальной отладки
# своего приёмника; встроенная песочница ATS работает и без этого.
WEBHOOK_ALLOW_PRIVATE_URLS=false
