# Переменные для VPS. Скопируйте в deploy/vps.env и заполните; файл vps.env не коммитится.

# Домен приложения. Нужны три A-записи на IP сервера: DOMAIN, fsp.DOMAIN и mail.DOMAIN.
DOMAIN=scout.example.ru
# Почта для уведомлений Let's Encrypt о сертификатах.
ACME_EMAIL=admin@example.ru

# Секреты: каждый — openssl rand -hex 32. Без них стенд не стартует.
JWT_SECRET=
ASSESSMENT_SECRET=
FSP_CLIENT_SECRET=
POSTGRES_PASSWORD=

# Пароли демо-аккаунтов для жюри (кандидат, работодатель, методист) и участников эмулятора ФСП.
DEMO_PASSWORD=
FSP_DEMO_PASSWORD=

# Mailpit за паролем: логин и bcrypt-хеш пароля.
# Хеш: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'пароль'
# Значение — в одинарных кавычках, иначе Compose примет $2a за переменную.
MAILPIT_USER=jury
MAILPIT_PASSWORD_HASH=''

# Порты Caddy на хосте (оставьте 80 и 443 — они нужны для выпуска сертификата).
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
